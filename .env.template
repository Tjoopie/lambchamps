# DevCockpit App Instance Environment
# Copy to .env and fill in values

# MCP Connection (get these from your DevCockpit admin)
DEVCOCKPIT_MCP_URL=https://devcockpit.ai/mcp/app/<YOUR_APP_ID>
DEVCOCKPIT_APP_KEY=<YOUR_MCP_KEY>
DEVCOCKPIT_APP_ID=<YOUR_APP_ID>
DEVCOCKPIT_APP_NAME=<YOUR_APP_NAME>

# LLM Access
# All LLM calls MUST go through DevCockpit agents (anthropic/openai provider steps).
# NEVER use raw API keys in application code.
# To create an agent with LLM capability: dc__create_agent with provider: 'anthropic' or 'openai'

# Cursor SDK (for dc_fix automated bug fixing - optional)
CURSOR_API_KEY=